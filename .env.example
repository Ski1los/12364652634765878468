# Copy this file to .env only when changing a default.
# Small is a good fully-local Whisper model for Russian and English.
WHISPER_MODEL=small

# One job at a time is safest on a CPU-only machine with 8–16 GB RAM.
MAX_WORKERS=1

# Optional local language model for genuinely semantic funny/awkward-moment picks.
# It is never a paid API: run Ollama from docker-compose and pull a model yourself.
# LOCAL_LLM_URL=http://ollama:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b

# Optional Netscape cookie file for videos that YouTube permits you to access
# only while signed in. Do not commit it.
# YTDLP_COOKIES_FILE=/data/cookies.txt

# Story Studio narration is fully local. Without a Piper model the app uses
# the included eSpeak NG fallback; it works offline but sounds synthetic.
# Put a Piper .onnx voice and its matching .onnx.json config under ./data/voices
# (that directory is mounted at /data/voices in Docker), then enable it:
# PIPER_VOICE_MODEL=/data/voices/ru_RU-your-voice-medium.onnx
# PIPER_SPEAKER=
