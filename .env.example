# Copy this file to .env, then tune only what you need.
# -----------------------------------------------------------------------------
# Recommended profile: Ryzen 5 5600 + RX 580 2048SP
# -----------------------------------------------------------------------------
# faster-whisper in this Docker image uses CPU/int8. RX 580 is not CUDA, so it
# cannot accelerate this pipeline through CTranslate2. These values keep the PC
# usable while a single 720p job is running.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=6
FFMPEG_THREADS=6
MAX_WORKERS=1

# Guard rails against a mistaken huge VOD filling the disk. Use 0 only when you
# deliberately want to remove a limit and have enough free storage.
MAX_SOURCE_MINUTES=120
MAX_SOURCE_MB=3500

# -----------------------------------------------------------------------------
# LLM choice: local first, or an explicit OpenAI-compatible cloud endpoint
# -----------------------------------------------------------------------------
# auto = local first, then cloud if local isn't configured
# local = never use cloud; cloud = use only CLOUD_LLM_* below
LLM_MODE=auto

# Local Ollama is entirely optional. qwen2.5:3b is much more realistic than 7b
# on a CPU-only 16 GB machine. With 8 GB RAM, leave it disabled and use the
# deterministic clip scorer or a cloud provider for Story Studio.
# LOCAL_LLM_URL=http://ollama:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_API_KEY=

# Optional cloud acceleration for SCRIPT WRITING and semantic clip selection.
# The endpoint must be HTTPS and OpenAI-compatible (/chat/completions). The key
# remains in this local .env and is never sent to the browser or committed.
# When cloud is active, the UI requests an explicit checkbox before it sends a
# Story idea or a short transcript digest. Video/audio never leaves this server.
# LLM_MODE=cloud
# CLOUD_LLM_URL=https://your-provider.example/v1
# CLOUD_LLM_MODEL=your-small-fast-model
# CLOUD_LLM_API_KEY=keep-this-secret

# -----------------------------------------------------------------------------
# Optional YouTube access and local narration
# -----------------------------------------------------------------------------
# Optional Netscape cookie file for videos that YouTube permits you to access
# only while signed in. Do not commit it.
# YTDLP_COOKIES_FILE=/data/cookies.txt

# yt-dlp network reliability. Chrome impersonation is enabled by default with
# curl-cffi. If your own server requires an outbound proxy, configure it here.
YTDLP_IMPERSONATE=chrome
# YTDLP_PROXY=http://proxy.example:8080
# YTDLP_FORCE_IPV4=1

# Story Studio narration is fully local. Without a Piper model the app uses
# included eSpeak NG; it works offline but sounds synthetic. Put a Piper .onnx
# voice and matching .onnx.json config under ./data/voices, then enable it:
# PIPER_VOICE_MODEL=/data/voices/ru_RU-your-voice-medium.onnx
# PIPER_SPEAKER=
